# Google Analytics measurement ID (leave unset to disable analytics)
NEXT_PUBLIC_GA_ID=

# Google Search Console verification code (Settings > Ownership verification > HTML tag > content value)
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification code (meta tag content value)
BING_SITE_VERIFICATION=

# Contact form email delivery via Resend (https://resend.com). Verify amren.ae as a sending domain there.
RESEND_API_KEY=
# Optional overrides. Defaults: from "AMREN Website <website@amren.ae>", to hello@amren.ae
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
